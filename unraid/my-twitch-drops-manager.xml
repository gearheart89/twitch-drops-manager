<?xml version="1.0"?>
<Container version="2">
  <Name>twitch-drops-manager</Name>
  <Repository>ghcr.io/gearheart89/twitch-drops-manager:latest</Repository>
  <Registry>https://github.com/gearheart89/twitch-drops-manager/pkgs/container/twitch-drops-manager</Registry>
  <Icon>https://raw.githubusercontent.com/gearheart89/twitch-drops-manager/manager/manager/web/icon.png</Icon>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/gearheart89/twitch-drops-manager/issues</Support>
  <Project>https://github.com/gearheart89/twitch-drops-manager</Project>
  <Overview>Multi-account Twitch Drops manager with encrypted account storage, global theme and manual renewal. Pulls the published image from GitHub Container Registry so Unraid can check for image updates. Initialize the encryption key using the included installer before creating a container. Fresh installations ask you to create a WebUI password.</Overview>
  <Category>GameServers: Tools:</Category>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/gearheart89/twitch-drops-manager/manager/unraid/my-twitch-drops-manager.xml</TemplateURL>
  <ExtraParams>--init --stop-timeout 90 --shm-size 512m --tmpfs /runtime:rw,nosuid,nodev,mode=0700,size=512m --tmpfs /tmp:rw,nosuid,nodev,mode=1777,size=1g</ExtraParams>
  <Config Name="WebUI port" Target="8080" Default="8080" Mode="tcp" Description="One dashboard for all accounts" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Encrypted account data" Target="/data" Default="/mnt/user/appdata/twitch-drops/data" Mode="rw" Description="Encrypted registry and account checkpoints" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/twitch-drops/data</Config>
  <Config Name="Encryption key file" Target="/run/secrets/account_key" Default="/mnt/user/appdata/twitch-drops-secrets/account-key" Mode="ro" Description="Existing key file; never change or regenerate while retaining account data" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/twitch-drops-secrets/account-key</Config>
  <Config Name="Timezone" Target="TZ" Default="America/Chicago" Mode="" Description="Match your home internet connection" Type="Variable" Display="always" Required="true" Mask="false">America/Chicago</Config>
  <Config Name="Public base URL" Target="PUBLIC_BASE_URL" Default="" Mode="" Description="Optional https://drops.example.com for a reverse proxy, without a subpath" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
  <Config Name="Allowed hostnames" Target="ALLOWED_HOSTS" Default="" Mode="" Description="Optional comma-separated server DNS names; IPs and local names work automatically" Type="Variable" Display="advanced" Required="false" Mask="false"></Config>
</Container>
